{
  "expo": {
    "name": "Link Inspection",
    "slug": "link-inspection-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.link.inspection"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.link.inspection"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan asset QR codes and photograph failed inspection items."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location sets the station (JNB or CPT) on each inspection."
        }
      ]
    ],
    "scheme": "linkinspection"
  }
}
