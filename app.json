{
  "expo": {
    "name": "LinkSpec",
    "slug": "linkspec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airlink.linkspec"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0048",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.airlink.linkspec"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan asset QR codes and photograph failed inspection items."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location sets the station (JNB or CPT) on each inspection."
        }
      ],
      "expo-font"
    ],
    "scheme": "linkspec",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0C0048",
      "resizeMode": "contain"
    },
    "primaryColor": "#0C0048"
  }
}
